# Copy to .env.local (never commit real values). Everything here is optional:
# without it the contact form tells visitors to email directly instead.

# Resend (https://resend.com): sends contact-form messages to you.
RESEND_API_KEY=
# Where messages are delivered.
CONTACT_TO_EMAIL=
# Sender. Must be on a domain verified in Resend; the default only delivers to your own Resend account email.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Cloudflare Turnstile (bot check). Set both, or neither.
# Setting the site key also opens the CSP to challenges.cloudflare.com (src/lib/security/csp.ts).
# It is read at build time, so rebuild after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
